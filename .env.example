# --- Database ---
POSTGRES_USER=upi_fip
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=upi_fip
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://upi_fip:change_me_local_only@db:5432/upi_fip

# --- Backend ---
BACKEND_PORT=8000
JWT_SECRET=change_me_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000

# --- AI ---
# Server-side only. Never exposed to the frontend.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_RATE_LIMIT_PER_MINUTE=10

# --- Data generation ---
SYNTHETIC_SEED=42
SYNTHETIC_TRANSACTION_COUNT=750000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
